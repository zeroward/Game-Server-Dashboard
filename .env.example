# Required: public website hostname, without https://, port, or path.
TUNNEL_HOSTNAME=
# Required: separately reachable WireGuard hostname/IP:UDP-port (not an HTTP URL).
VPN_ENDPOINT=

# Put the Cloudflare tunnel token in this ignored file, not in .env.
# See docs/tunnel.md for creating it with permissions for container UID 65532.
TUNNEL_TOKEN_FILE=./secrets/cloudflare-token

# Advanced: host-side WireGuard UDP publication (endpoint must match).
# Loopback by default; choose a reachable interface/forwarding arrangement deliberately.
VPN_BIND_IP=127.0.0.1
VPN_UDP_PORT=51820

# Advanced: change all three together if the private Docker bridge overlaps locally.
TUNNEL_SUBNET=172.30.250.0/29
TUNNEL_CONNECTOR_IP=172.30.250.2
TUNNEL_PORTAL_IP=172.30.250.3
