# Development uses HTTP and non-Secure cookies. Set production behind HTTPS.
APP_ENV=development
BASE_URL=http://localhost:8080
# Comma-separated proxy source CIDRs. Empty ignores forwarded headers.
TRUSTED_PROXIES=

# Optional VPN phase: enable using compose.vpn.yaml, not normal startup.
# Public/operator-controlled UDP endpoint (no URL scheme). Leave unset until configured.
VPN_ENDPOINT=
# Loopback by default. Change deliberately when publishing a reachable VPN listener.
VPN_BIND_IP=127.0.0.1
VPN_UDP_PORT=51820

# Optional Cloudflare Tunnel overlay: HTTPS website access, not WireGuard UDP.
# Hostname only (no https:// prefix/path); leave unset until configured in Cloudflare.
TUNNEL_HOSTNAME=
# Store the tunnel token in this ignored file, never in .env or a Compose command.
TUNNEL_TOKEN_FILE=./secrets/cloudflare-token
# Change all three together if this dedicated Docker subnet conflicts locally.
TUNNEL_SUBNET=172.30.250.0/29
TUNNEL_CONNECTOR_IP=172.30.250.2
TUNNEL_PORTAL_IP=172.30.250.3
