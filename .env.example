# Development uses HTTP and non-Secure cookies. Set production behind HTTPS.
APP_ENV=development
BASE_URL=http://localhost:8080
# Comma-separated proxy source CIDRs. Empty ignores forwarded headers.
TRUSTED_PROXIES=

# Optional VPN phase: enable using compose.vpn.yaml, not normal startup.
# Public/operator-controlled UDP endpoint (no URL scheme). Leave unset until configured.
VPN_ENDPOINT=
# Loopback by default. Change deliberately when publishing a reachable VPN listener.
VPN_BIND_IP=127.0.0.1
VPN_UDP_PORT=51820
